<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

<Properties>
<Property name="basePath">logs</Property>
</Properties>



    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </Console>

        <RollingFile
            name="File"
            fileName="${basePath}/automation.log"
            filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log.gz">

            <PatternLayout>
                <Pattern>
                    %d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n
                </Pattern>
            </PatternLayout>

            <Policies>

               

                <!-- Also create a new file when it reaches 10 MB -->
                <SizeBasedTriggeringPolicy size="10 MB"/>

            </Policies>

           

        </RollingFile>

    </Appenders>

    <Loggers>

        <Root level="Debug">

           <!-- <AppenderRef ref="Console"/> --> 
            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>